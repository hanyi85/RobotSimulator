<Window x:Class="CPCRobotSimulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="cpcRobot 控制監控終端" Height="600" Width="450" Background="#0A0A0A">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 標題 -->
            <RowDefinition Height="*"/>
            <!-- 顯示器 -->
            <RowDefinition Height="Auto"/>
            <!-- 控制區 -->
        </Grid.RowDefinitions>

        <!-- 1. 標題區 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="SYSTEM MONITOR" Foreground="#64748B" FontSize="10" FontWeight="Bold" />
            <TextBlock Text="DB0 機器手臂控制器" Foreground="White" FontSize="20" FontWeight="ExtraBold"/>
            <Rectangle Height="2" Fill="#38BDF8" HorizontalAlignment="Left" Width="50" Margin="0,5"/>
        </StackPanel>

        <!-- 2. 核心監視器 -->
        <Border Grid.Row="1" Background="#111111" BorderBrush="#334155" BorderThickness="1" CornerRadius="200" Width="300" Height="300" VerticalAlignment="Center">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="ARM DISTANCE" Foreground="#64748B" FontSize="10" HorizontalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Name="txtDistance" Text="0.0" Foreground="#38BDF8" FontSize="48" FontWeight="Light"/>
                    <TextBlock Text="mm" Foreground="#38BDF8" FontSize="14" VerticalAlignment="Bottom" Margin="5,0,0,10"/>
                </StackPanel>

                <!-- 狀態燈 -->
                <Ellipse Name="elpStatus" Width="15" Height="15" Fill="#34D399" Margin="0,10">
                    <Ellipse.Effect>
                        <DropShadowEffect Color="#34D399" BlurRadius="10" ShadowDepth="0"/>
                    </Ellipse.Effect>
                </Ellipse>
                <TextBlock Name="txtAlert" Text="SYSTEM READY" Foreground="#34D399" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 3. 控制面板 -->
        <StackPanel Grid.Row="2" Margin="0,20,0,0">
            <UniformGrid Columns="3" Margin="0,0,0,10">
                <StackPanel Margin="5">
                    <TextBlock Text="X-AXIS" Foreground="#94A3B8" FontSize="10" HorizontalAlignment="Center"/>
                    <Slider Name="sldX" Minimum="-300" Maximum="300" Orientation="Vertical" Height="120" HorizontalAlignment="Center" Margin="0,10" ValueChanged="UpdateRobotStatus"/>
                    <TextBlock Text="{Binding Value, ElementName=sldX, StringFormat={}{0:F0}}" Foreground="White" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel Margin="5">
                    <TextBlock Text="Y-AXIS" Foreground="#94A3B8" FontSize="10" HorizontalAlignment="Center"/>
                    <Slider Name="sldY" Minimum="-300" Maximum="300" Orientation="Vertical" Height="120" HorizontalAlignment="Center" Margin="0,10" ValueChanged="UpdateRobotStatus"/>
                    <TextBlock Text="{Binding Value, ElementName=sldY, StringFormat={}{0:F0}}" Foreground="White" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel Margin="5">
                    <TextBlock Text="Z-AXIS" Foreground="#94A3B8" FontSize="10" HorizontalAlignment="Center"/>
                    <Slider Name="sldZ" Minimum="0" Maximum="500" Orientation="Vertical" Height="120" HorizontalAlignment="Center" Margin="0,10" ValueChanged="UpdateRobotStatus"/>
                    <TextBlock Text="{Binding Value, ElementName=sldZ, StringFormat={}{0:F0}}" Foreground="White" HorizontalAlignment="Center"/>
                </StackPanel>
            </UniformGrid>

            <Button Content="EMERGENCY RESET" Click="btnHome_Click" Background="#1E293B" Foreground="#94A3B8" BorderBrush="#334155" Height="35" Margin="0,10,0,0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>